// Custom Champion Monster System
// 5 normal kills per map -> one Champion based on the monster that completed the counter.
// All Champions: HP x20, ATK x3, MATK x1.5, DEF x2, MDEF x2, Drop Rate x2.
// Precious Champion overrides the common drop bonus with Drop Rate x5 total.
// Experienced Champion grants Base EXP x50 and Job EXP x50.
// Types: 1 Furious, 2 Precious, 3 Fleeting, 4 Arcane, 5 Experienced.

-	script	ChampionMonsterSystem	-1,{
OnInit:
	.KillThreshold = 5;
	.FuriousPowerUpLevel = 5; // NPC_POWERUP, the MVP low-HP Power Up state (NOT Acolyte Increase AGI)
	$ChampionCount = 0;
	.AuraPulse = 0;
	initnpctimer;
	end;

OnNPCKillEvent:
	if (!getbattleflag("funk_master_enable") || !getbattleflag("funk_champion")) end;
	if (!killedrid || !killedgid) end;
	.@map$ = strcharinfo(3);
	if (.@map$ == "") end;
	// Champion kills do not advance the normal map counter.
	if (getd("$ChampionType_" + killedgid) > 0) end;
	.@key$ = "$ChampionKills_" + .@map$;
	setd .@key$, getd(.@key$) + 1;
	if (getd(.@key$) < .KillThreshold) end;
	setd .@key$, 0;
	// killedrid is the monster class. killedgid is the runtime unit, which is already dying.
	.@class = killedrid;
	if (.@class <= 0) end;
	.@type = rand(1,5);
	.@prefix$ = (.@type==1?"Furioso":(.@type==2?"Precioso":(.@type==3?"Fugaz":(.@type==4?"Arcano":"Experiente"))));
	.@name$ = getmonsterinfo(.@class,MOB_NAME);
	monster .@map$,0,0,"["+.@prefix$+"] "+.@name$,.@class,1,"ChampionMonsterSystem::OnChampionKilled";
	.@gid = $@mobid[0];
	if (.@gid <= 0 || !unitexists(.@gid)) end;
	getunitdata .@gid, .@c;
	setd "$ChampionType_" + .@gid, .@type;
	setd "$ChampionClass_" + .@gid, .@class;
	setunitdata .@gid, UMOB_CHAMPION_TYPE, .@type;
	setunitdata .@gid, UMOB_MAXHP, .@c[UMOB_MAXHP] * 20;
	setunitdata .@gid, UMOB_HP, .@c[UMOB_MAXHP] * 20;
	setunitdata .@gid, UMOB_ATKMIN, .@c[UMOB_ATKMIN] * 3;
	setunitdata .@gid, UMOB_ATKMAX, .@c[UMOB_ATKMAX] * 3;
	setunitdata .@gid, UMOB_MATKMIN, .@c[UMOB_MATKMIN] * 3 / 2;
	setunitdata .@gid, UMOB_MATKMAX, .@c[UMOB_MATKMAX] * 3 / 2;
	setunitdata .@gid, UMOB_DEF, .@c[UMOB_DEF] * 2;
	setunitdata .@gid, UMOB_MDEF, .@c[UMOB_MDEF] * 2;
	if (.@type == 3) { // Fleeting: 50% more attacks/time and movement speed.
		setunitdata .@gid, UMOB_SPEED, max(1,.@c[UMOB_SPEED] * 2 / 3);
		setunitdata .@gid, UMOB_AMOTION, max(1,.@c[UMOB_AMOTION] * 2 / 3);
	}
	if (.@type == 4) { // Arcane: +50% magical damage on top of Champion MATK x1.5 => effective MATK x2.25.
		setunitdata .@gid, UMOB_MATKMIN, .@c[UMOB_MATKMIN] * 9 / 4;
		setunitdata .@gid, UMOB_MATKMAX, .@c[UMOB_MATKMAX] * 9 / 4;
	}
	getunitdata .@gid, .@final;
	debugmes sprintf("CHAMPION_AUDIT spawn type=%d gid=%d class=%d HP=%d->%d ATK=%d-%d->%d-%d MATK=%d-%d->%d-%d DEF=%d->%d MDEF=%d->%d SPEED=%d->%d AMOTION=%d->%d", .@type, .@gid, .@class, .@c[UMOB_MAXHP], .@final[UMOB_MAXHP], .@c[UMOB_ATKMIN], .@c[UMOB_ATKMAX], .@final[UMOB_ATKMIN], .@final[UMOB_ATKMAX], .@c[UMOB_MATKMIN], .@c[UMOB_MATKMAX], .@final[UMOB_MATKMIN], .@final[UMOB_MATKMAX], .@c[UMOB_DEF], .@final[UMOB_DEF], .@c[UMOB_MDEF], .@final[UMOB_MDEF], .@c[UMOB_SPEED], .@final[UMOB_SPEED], .@c[UMOB_AMOTION], .@final[UMOB_AMOTION]);
	// Type-specific visual stack rendered directly on the monster GID.
	if (.@type == 1) {
		unitspecialeffect .@gid, EF_BEGINSPELL2;
		unitspecialeffect .@gid, EF_MAXPOWER;
	} else if (.@type == 2) {
		unitspecialeffect .@gid, EF_BEGINSPELL3;
		unitspecialeffect .@gid, EF_COIN;
	} else if (.@type == 3) {
		unitspecialeffect .@gid, EF_BEGINSPELL;
		unitspecialeffect .@gid, EF_TWOHANDQUICKEN;
	} else if (.@type == 4) {
		unitspecialeffect .@gid, EF_BEGINSPELL5;
		unitspecialeffect .@gid, EF_ENERGYCOAT;
	} else {
		unitspecialeffect .@gid, EF_BEGINSPELL6;
		unitspecialeffect .@gid, EF_ANGEL;
	}
	unitspecialeffect .@gid, 106;
	unitspecialeffect .@gid, 107;
	unitspecialeffect .@gid, 108;
	$ChampionGid[$ChampionCount] = .@gid;
	++$ChampionCount;
	getunitdata .@gid, .@pos;
	mapannounce .@map$, "[CHAMPION] " + .@prefix$ + " " + .@name$ + " surgiu! Coordenadas: (" + .@pos[UMOB_X] + ", " + .@pos[UMOB_Y] + ")", bc_map, (.@type==1?0x3333FF:(.@type==2?0x33CCFF:(.@type==3?0xFFFF66:(.@type==4?0xFF66CC:0xFFCC66))));
	end;

OnTimer1000:
	if (!getbattleflag("funk_master_enable") || !getbattleflag("funk_champion")) {
		setnpctimer 0;
		end;
	}
	// Monitor Furious Champions and keep NPC_POWERUP active while HP remains <= 51%.
	++.AuraPulse;
	.@showAura = (.AuraPulse % 3 == 0);
	.@write = 0;
	for (.@i = 0; .@i < $ChampionCount; ++.@i) {
		.@gid = $ChampionGid[.@i];
		if (!unitexists(.@gid) || getd("$ChampionType_"+.@gid) <= 0) continue;
		$ChampionGid[.@write] = .@gid;
		++.@write;
		if (.@showAura) {
			.@type = getd("$ChampionType_"+.@gid);
			if (.@type == 1) {
				unitspecialeffect .@gid, EF_BEGINSPELL2;
				unitspecialeffect .@gid, EF_MAXPOWER;
			} else if (.@type == 2) {
				unitspecialeffect .@gid, EF_BEGINSPELL3;
				unitspecialeffect .@gid, EF_COIN;
			} else if (.@type == 3) {
				unitspecialeffect .@gid, EF_BEGINSPELL;
				unitspecialeffect .@gid, EF_TWOHANDQUICKEN;
			} else if (.@type == 4) {
				unitspecialeffect .@gid, EF_BEGINSPELL5;
				unitspecialeffect .@gid, EF_ENERGYCOAT;
			} else {
				unitspecialeffect .@gid, EF_BEGINSPELL6;
				unitspecialeffect .@gid, EF_ANGEL;
			}
		}
		// These three animations are short, so renew each one on every 1-second tick.
		unitspecialeffect .@gid, 106;
		unitspecialeffect .@gid, 107;
		unitspecialeffect .@gid, 108;
		if (getd("$ChampionType_"+.@gid) != 1) continue;
		getunitdata .@gid, .@u;
		if (.@u[UMOB_HP] * 100 <= .@u[UMOB_MAXHP] * 51 && (!getd("$ChampionRaged_"+.@gid) || .AuraPulse % 20 == 0)) {
			if (!getd("$ChampionRaged_"+.@gid))
				debugmes sprintf("CHAMPION_AUDIT rage gid=%d HP=%d/%d", .@gid, .@u[UMOB_HP], .@u[UMOB_MAXHP]);
			setd "$ChampionRaged_"+.@gid, 1;
			unitskilluseid .@gid, NPC_POWERUP, .FuriousPowerUpLevel, .@gid, 0, 0, 0, 1;
		}
	}
	for (.@i = .@write; .@i < $ChampionCount; ++.@i)
		$ChampionGid[.@i] = 0;
	$ChampionCount = .@write;
	setnpctimer 0;
	end;

OnChampionKilled:
	if (!getbattleflag("funk_master_enable") || !getbattleflag("funk_champion")) end;
	.@gid = killedgid;
	setd "$ChampionType_"+.@gid,0;
	setd "$ChampionClass_"+.@gid,0;
	setd "$ChampionRaged_"+.@gid,0;
	end;
}
